{
  "name": "grateful-dead-iverse",
  "private": true,
  "description": "Tooling for the Grateful Dead markdown corpus repository",
  "type": "module",
  "scripts": {
    "bump-modified-gmt": "node scripts/bump-modified-gmt.mjs",
    "sync-from-site": "node scripts/sync-from-export.mjs",
    "test": "node --test test/*.test.mjs",
    "zip-changed": "node scripts/zip-changed.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "site:dev": "npm run dev --prefix site",
    "site:build": "npm run build --prefix site"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "gray-matter": "^4.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
