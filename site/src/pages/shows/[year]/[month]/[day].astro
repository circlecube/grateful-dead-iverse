---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import ShowPageContent from '../../../../components/ShowPageContent.astro';
import { getCorpus } from '../../../../lib/corpus';
import { descriptionForShow } from '../../../../lib/meta';

export function getStaticPaths() {
	const { shows, duplicateShowById } = getCorpus();
	return shows.map((show, index) => ({
		params: { year: show.year, month: show.month, day: show.day },
		props: {
			show,
			prevShow: index > 0 ? shows[index - 1] : null,
			nextShow: index < shows.length - 1 ? shows[index + 1] : null,
			duplicateNotice: duplicateShowById.get(show.id) ?? null,
		},
	}));
}

interface Props {
	show: import('../../../../lib/corpus').ShowRecord;
	prevShow: import('../../../../lib/corpus').ShowRecord | null;
	nextShow: import('../../../../lib/corpus').ShowRecord | null;
	duplicateNotice: import('../../../../lib/corpus').EntityDuplicateNotice | null;
}

const { show, prevShow, nextShow, duplicateNotice } = Astro.props;
---

<BaseLayout
	title={`${show.date}${show.venueName ? ` — ${show.venueName}` : ''} — Grateful Dead-iverse`}
	description={descriptionForShow(show)}
	ogType="article"
	permalink={show.permalink}
>
	<ShowPageContent
		show={show}
		prevShow={prevShow}
		nextShow={nextShow}
		duplicateNotice={duplicateNotice}
	/>
</BaseLayout>
