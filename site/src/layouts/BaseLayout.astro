---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SortableTableScript from '../components/SortableTableScript.astro';
import {
	DEFAULT_DESCRIPTION,
	OG_IMAGE_HEIGHT,
	OG_IMAGE_WIDTH,
	SITE_NAME,
	absoluteOgImage,
	truncateMetaDescription,
} from '../lib/site-meta';
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
	ogType?: 'website' | 'article';
	/** When true, adds noindex (e.g. dev fixtures). */
	noindex?: boolean;
}

const {
	title,
	description = DEFAULT_DESCRIPTION,
	ogType = 'website',
	noindex = false,
} = Astro.props;

const site = Astro.site ?? new URL('http://localhost:4321');
const canonicalURL = new URL(Astro.url.pathname, site);
const pageDescription = truncateMetaDescription(description);
const ogImage = absoluteOgImage(site);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={pageDescription} />
		<link rel="canonical" href={canonicalURL} />
		<link rel="icon" type="image/svg+xml" href="/deadiverse-icon-face.svg" />
		<link rel="apple-touch-icon" href="/deadiverse-icon-face.svg" />
		<title>{title}</title>
		<meta property="og:type" content={ogType} />
		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={pageDescription} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content={String(OG_IMAGE_WIDTH)} />
		<meta property="og:image:height" content={String(OG_IMAGE_HEIGHT)} />
		<meta property="og:image:alt" content={`${SITE_NAME} — Grateful Dead shows and songs`} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={pageDescription} />
		<meta name="twitter:image" content={ogImage} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
	</head>
	<body>
		<SiteHeader />
		<main>
			<slot />
		</main>
		<SiteFooter />
		<SortableTableScript />
	</body>
</html>
