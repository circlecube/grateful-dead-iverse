---
import GitHubMark from './GitHubMark.astro';
import SiteFreshness from './SiteFreshness.astro';
import { DEADIVERSE_URL, REPO_URL } from '../lib/site-links';

interface Props {
	corpusModifiedGmt?: string;
}

const { corpusModifiedGmt } = Astro.props;
---

<footer class="site-footer">
	<nav class="site-footer__icons" aria-label="Deadiverse and GitHub">
		<a href={DEADIVERSE_URL} class="site-footer__icon-link" title="deadiverse.com">
			<img src="/deadiverse-icon-face.svg" alt="Deadiverse" width="28" height="28" />
		</a>
		<a href={REPO_URL} class="site-footer__icon-link site-footer__icon-link--github" title="Grateful Dead-iverse on GitHub">
			<GitHubMark size={28} />
			<span class="visually-hidden">GitHub repository</span>
		</a>
	</nav>
	<SiteFreshness corpusModifiedGmt={corpusModifiedGmt} />
</footer>

<style>
	.site-footer {
		margin-top: 1rem;
		padding: 1.75rem 1rem;
		background: var(--dv-chrome-bg);
		color: var(--dv-chrome-text);
		border-top: 3px solid var(--dv-accent-2);
	}
	.site-footer__icons {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1.25rem;
		max-width: var(--dv-wide-max);
		margin: 0 auto;
	}
	.site-footer__icon-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		line-height: 0;
		border-radius: 0.35rem;
		transition: opacity 0.15s ease, transform 0.15s ease;
	}
	.site-footer__icon-link:hover {
		opacity: 0.88;
		transform: translateY(-1px);
	}
	.site-footer__icon-link--github {
		color: var(--dv-chrome-text);
	}
	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}
</style>
